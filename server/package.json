{
  "name": "@rds/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "create-user": "node dist/server/src/cli/create-user.js",
    "create-user:dev": "tsx src/cli/create-user.ts",
    "reset-password": "node dist/server/src/cli/reset-password.js",
    "reset-password:dev": "tsx src/cli/reset-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.0.0",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.12.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4"
  }
}
