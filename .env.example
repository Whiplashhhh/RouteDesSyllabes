# Copiez ce fichier en « .env » puis adaptez les valeurs : cp .env.example .env

# Port public de l'application sur le serveur (http://IP:APP_PORT).
# Choisissez un port libre si d'autres services tournent déjà sur le VPS.
APP_PORT=8080

# Adresse d'écoute sur l'hôte. Derrière un reverse proxy (Nginx, Caddy…) sur le même serveur,
# mettez 127.0.0.1 pour que l'application ne soit joignable qu'à travers lui.
APP_BIND=0.0.0.0

# Secret qui protège les sessions (au moins 32 caractères, à garder secret).
# Pour en générer un : openssl rand -base64 48
SESSION_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire-de-48-caracteres

# true uniquement quand le site est servi en HTTPS (derrière Nginx, Caddy…).
# En HTTP simple (http://IP:PORT), laissez false sinon la connexion échouera.
COOKIE_SECURE=false

# Autoriser la création de comptes depuis la page de connexion.
# Par défaut, les comptes se créent avec : docker compose exec app npm run create-user -- ...
ALLOW_SIGNUP=false

# true si l'application est derrière un reverse proxy (Nginx, Caddy, Traefik).
# Nécessaire pour connaître la vraie adresse IP des visiteurs (limitation des tentatives).
TRUST_PROXY=false
